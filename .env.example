# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The deployed frontend URL allowed to call the API in production.
# The API allows localhost:3000 and 127.0.0.1:3000 automatically outside production.
APP_URL="MY_APP_URL"

# Server configuration for the Phase 1 Express API.
NODE_ENV="development"
PORT="4000"
TRUST_PROXY_HOPS="0"
API_RATE_LIMIT_WINDOW_MS="60000"
API_RATE_LIMIT_MAX="10000"
LOG_LEVEL="info"
